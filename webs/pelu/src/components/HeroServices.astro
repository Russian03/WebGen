---
import { useTranslations } from '../locales/utils';
import BookingModal from './BookingModal.astro';
import Footer from './Footer.astro';

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="home" class="hero">
  <div class="hero-content">
    <h1 class="brand-name">{t('shop.name')}</h1>
    <h2 class="subtitle-main">{t('hero.title')}</h2>
    <p class="info-text">{t('hero.subtitle')}</p>
    <button class="cta open-booking-btn" data-service="">{t('hero.cta')}</button>
  </div>
</div>

<div id="services" class="services-section">
  <div class="services-container">
    <h2 class="section-title">{t('services.title')}</h2>
    <p class="section-subtitle">{t('services.subtitle')}</p>
    
    <div class="services-grid">
      <div class="service-card open-booking-btn" data-service="tallar">
        <div class="card-image-wrapper">
          <img src="https://as1.ftcdn.net/jpg/03/10/21/40/1000_F_310214064_CFSi6HpZSqgGFU1QjGYPi8mhl1teABwC.jpg" alt="Tallar" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.cut')}</h3>
          <p>{t('services.cut.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>

      <div class="service-card open-booking-btn" data-service="tallar-rentar">
        <div class="card-image-wrapper">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&q=60&w=500" alt="Rentar" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.wash')}</h3>
          <p>{t('services.wash.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>

      <div class="service-card open-booking-btn" data-service="color">
        <div class="card-image-wrapper">
          <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&q=60&w=500" alt="Color" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.color')}</h3>
          <p>{t('services.color.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>

      <div class="service-card open-booking-btn" data-service="uv">
        <div class="card-image-wrapper">
          <img src="https://images.unsplash.com/photo-1519699047748-de8e457a634e?auto=format&fit=crop&q=60&w=500" alt="Tractament UV" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.uv')}</h3>
          <p>{t('services.uv.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>

      <div class="service-card open-booking-btn" data-service="permanent">
        <div class="card-image-wrapper">
          <img src="https://www.mybeautygolden.com/wp-content/uploads/2024/02/permanente-madrid.jpg" alt="Permanent" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.perm')}</h3>
          <p>{t('services.perm.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>

      <div class="service-card open-booking-btn" data-service="barba">
        <div class="card-image-wrapper">
          <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&q=60&w=500" alt="Barba" />
        </div>
        <div class="card-content">
          <h3>{t('booking.service.shave')}</h3>
          <p>{t('services.shave.desc')}</p>
          <span class="card-link">{t('hero.cta')} &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="about" class="about-section">
  <div class="about-container">
    <div class="about-content">
      <h2 class="section-title">{t('about.title')}</h2>
      <p class="section-subtitle">{t('about.subtitle')}</p>
      <p class="about-text">{t('about.desc1')}</p>
      <p class="about-text">{t('about.desc2')}</p>
    </div>
    <div class="about-image">
      <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&q=80&w=800" alt="Sobre Nosaltres - HAIRSTUDIO" />
    </div>
  </div>
</div>

<BookingModal lang={lang} />
<Footer lang={lang} />

<script>
  import { initBookingModal } from './BookingLogic.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  initBookingModal();

  function setupAnimations() {
    const heroElements = document.querySelectorAll('.brand-name, .subtitle-main, .info-text');
    const heroCta = document.querySelector('.hero .cta');

    if (heroElements.length > 0) {
      gsap.fromTo(
        heroElements,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power3.out',
          clearProps: 'transform,opacity'
        }
      );
    }

    if (heroCta) {
      gsap.fromTo(
        heroCta,
        { y: 20, opacity: 0, scale: 0.95 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          delay: 0.4,
          ease: 'power3.out',
          clearProps: 'transform,opacity'
        }
      );
    }

    gsap.fromTo(
      '.section-title, .section-subtitle',
      { y: 30, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '#services',
          start: 'top 85%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.2,
        ease: 'power2.out',
        clearProps: 'transform,opacity'
      }
    );

    gsap.fromTo(
      '.service-card',
      { y: 50, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.services-grid',
          start: 'top 85%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power3.out',
        clearProps: 'transform,opacity'
      }
    );

    gsap.fromTo(
      '.about-content, .about-image',
      { y: 40, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '#about',
          start: 'top 80%',
          toggleActions: 'play none none none'
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.2,
        ease: 'power3.out',
        clearProps: 'transform,opacity'
      }
    );
  }

  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    setupAnimations();
  } else {
    window.addEventListener('DOMContentLoaded', () => {
      setupAnimations();
    });
  }

  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });
</script>

<style>
  .hero {
    height: 100dvh; 
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    box-sizing: border-box;
    padding-top: 70px; 
    margin-top: 0;
  }
  .hero-content {
    background: rgba(255, 255, 255, 0.85);
    padding: 50px 60px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    max-width: 800px;
    margin: 0 auto;
  }
  .brand-name { font-size: 4.5rem; margin: 0; letter-spacing: 8px; font-weight: 300; color: var(--text-main); }
  .subtitle-main { font-size: 1.4rem; margin: 15px 0 20px 0; font-weight: 400; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; }
  .info-text { font-size: 1rem; color: var(--text-muted); max-width: 550px; margin: 0 auto 40px auto; line-height: 1.6; }
  
  .cta {
    padding: 16px 45px; background-color: var(--text-main); color: #fff;
    font-weight: 500; border: none; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; font-size: 0.9rem; transition: all 0.3s ease;
  }
  .cta:hover { background-color: var(--accent); }

  .services-section { 
    padding: 90px 20px; 
    background-color: rgba(255, 255, 255, 0.4); 
  }
  .services-container { 
    max-width: 1140px; 
    margin: 0 auto; 
    text-align: center; 
  }
  .section-title { 
    font-size: 2.5rem; 
    font-weight: 300; 
    letter-spacing: 3px; 
    color: var(--text-main);
    margin-bottom: 12px; 
  }
  .section-subtitle { 
    color: var(--text-muted); 
    margin-bottom: 60px; 
    font-size: 1.05rem; 
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 35px;
  }
  
  .service-card {
    background: #ffffff;
    border-radius: 24px; 
    border: 1px solid rgba(28, 26, 23, 0.04);
    text-align: left;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    overflow: hidden;
    padding: 16px;
    box-shadow: 0 10px 30px rgba(28, 26, 23, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .service-card:hover {
    transform: translateY(-8px) scale(1.01);
    border-color: rgba(191, 163, 122, 0.3);
    box-shadow: 0 20px 40px rgba(191, 163, 122, 0.12);
  }
  
  .card-image-wrapper {
    width: 100%;
    height: 240px;
    overflow: hidden;
    border-radius: 16px; 
    background-color: #f7f5f0;
    position: relative;
  }
  
  .card-image-wrapper img {
    width: 100%; 
    height: 100%; 
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .service-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }
  
  .card-content { 
    padding: 24px 12px 12px 12px; 
    display: flex; 
    flex-direction: column; 
    flex-grow: 1; 
  }
  
  .service-card h3 { 
    font-size: 1.35rem; 
    margin: 0 0 10px 0; 
    font-weight: 400; 
    letter-spacing: 0.5px; 
    color: var(--text-main); 
  }
  
  .service-card p { 
    color: var(--text-muted); 
    font-size: 0.95rem; 
    line-height: 1.6; 
    margin: 0 0 25px 0; 
    flex-grow: 1; 
  }
  
  .card-link {
    font-size: 0.8rem; 
    text-transform: uppercase; 
    letter-spacing: 2px; 
    font-weight: 600; 
    color: var(--text-main); 
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
  }
  
  .service-card:hover .card-link { 
    color: #bfa37a; 
    transform: translateX(4px);
  }

  .about-section {
    padding: 100px 20px;
    background-color: #ffffff;
  }

  .about-container {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-content .section-title {
    text-align: left;
  }

  .about-content .section-subtitle {
    text-align: left;
    margin-bottom: 30px;
  }

  .about-text {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .about-image {
    width: 100%;
    height: 420px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(28, 26, 23, 0.08);
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero {
      height: 100dvh;
      min-height: 100dvh;
      padding-top: 70px;
      margin-top: 0;
    }

    .hero-content {
      padding: 35px 20px;
      width: 100%;
      box-sizing: border-box;
      border-radius: 20px;
    }

    .brand-name {
      font-size: 2.2rem;
      letter-spacing: 3px;
      line-height: 1.25;
      margin-bottom: 10px;
    }

    .subtitle-main {
      font-size: 0.95rem;
      letter-spacing: 1.5px;
      margin: 10px 0 15px 0;
    }

    .info-text {
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 30px;
    }

    .cta {
      width: 100%;
      padding: 16px 20px;
      font-size: 0.85rem;
      box-sizing: border-box;
    }

    .about-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-image {
      height: 300px;
    }
  }
</style>